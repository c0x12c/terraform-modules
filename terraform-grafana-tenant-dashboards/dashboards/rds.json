{
  "uid": "rds",
  "title": "RDS",
  "description": "Database CPU, storage and connections",
  "tags": [],
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "constant",
        "query": "namespace-placeholder",
        "hide": 2,
        "current": {
          "text": "namespace-placeholder",
          "value": "namespace-placeholder"
        },
        "options": [
          {
            "text": "namespace-placeholder",
            "value": "namespace-placeholder",
            "selected": true
          }
        ]
      },
      {
        "name": "aws_tag_project",
        "label": "AWS project",
        "type": "constant",
        "query": "aws_tag_project-placeholder",
        "hide": 2,
        "current": {
          "text": "aws_tag_project-placeholder",
          "value": "aws_tag_project-placeholder"
        },
        "options": [
          {
            "text": "aws_tag_project-placeholder",
            "value": "aws_tag_project-placeholder",
            "selected": true
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "Scope",
      "options": {
        "mode": "markdown",
        "content": "Scoped to the namespace and service of this environment. Red lines are alert thresholds."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "RDS CPU %",
      "description": "Alert RdsCpuHigh: above 80 for 5m",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (dimension_DBInstanceIdentifier) (aws_rds_cpuutilization_average{namespace=\"$namespace\",name!=\"global\",tag_Project=\"$aws_tag_project\"})",
          "legendFormat": "{{dimension_DBInstanceIdentifier}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "RDS free storage (min)",
      "description": "No alert: total storage unknown",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (dimension_DBInstanceIdentifier) (aws_rds_free_storage_space_minimum{namespace=\"$namespace\",name!=\"global\",tag_Project=\"$aws_tag_project\"})",
          "legendFormat": "{{dimension_DBInstanceIdentifier}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "RDS connections (max)",
      "description": "No alert: max_connections unknown",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (dimension_DBInstanceIdentifier) (aws_rds_database_connections_maximum{namespace=\"$namespace\",name!=\"global\",tag_Project=\"$aws_tag_project\"})",
          "legendFormat": "{{dimension_DBInstanceIdentifier}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "links": []
}
